@echo off
setlocal EnableExtensions
title Windows 11 - Desktop-Verknuepfung anlegen
rem ============================================================
rem  Legt die Desktop-Verknuepfung "Herunterfahren" (inkl. Icon)
rem  neu an. Nuetzlich, wenn die Verknuepfung fehlt, geloescht
rem  wurde oder nicht sichtbar ist.
rem  Voraussetzung: Installieren.cmd wurde bereits ausgefuehrt.
rem  Diese Datei enthaelt absichtlich keine Umlaute.
rem ============================================================

if not defined HF_ZIEL set "HF_ZIEL=%LOCALAPPDATA%\Herunterfahren"

echo.
echo   ==========================================================
echo    Desktop-Verknuepfung "Herunterfahren" anlegen
echo   ==========================================================
echo.

powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
if errorlevel 2 goto kein_ziel
if errorlevel 1 goto fehler

echo.
echo   Fertig. Die Verknuepfung liegt jetzt auf dem Desktop.
echo.
pause
exit /b 0

:kein_ziel
echo.
echo   Bitte zuerst "Installieren.cmd" ausfuehren - das Programm
echo   wurde hier nicht gefunden:
echo   %HF_ZIEL%
echo.
pause
exit /b 2

:fehler
echo.
echo   Es konnte keine Verknuepfung angelegt werden.
echo   Bitte den Text oben pruefen.
echo.
pause
exit /b 1
