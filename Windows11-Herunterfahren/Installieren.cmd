@echo off
setlocal EnableExtensions
title Windows 11 - Herunterfahren installieren
rem ============================================================
rem  Installiert das saubere Herunterfahren:
rem    - kopiert die Skripte nach %LOCALAPPDATA%\Herunterfahren
rem    - entpackt das Icon (ist in dieser Datei eingebettet!)
rem    - legt eine Desktop-Verknuepfung MIT Icon an
rem  Einfach doppelklicken - keine Adminrechte noetig.
rem  Hinweis: Diese Datei enthaelt absichtlich keine Umlaute.
rem ============================================================

set "QUELLE=%~dp0"
set "ZIEL=%LOCALAPPDATA%\Herunterfahren"

echo.
echo   ==========================================================
echo    Windows 11 - sauberes Herunterfahren installieren
echo   ==========================================================
echo.
echo    Quelle : %QUELLE%
echo    Ziel   : %ZIEL%
echo.

if not exist "%QUELLE%Herunterfahren.cmd" goto fehlt_quelle

if not exist "%ZIEL%" mkdir "%ZIEL%" >nul 2>&1
if not exist "%ZIEL%" goto fehler_ziel

echo   [1/4] Skripte kopieren ...
if /i "%QUELLE%"=="%ZIEL%\" goto skripte_ok
copy /y "%QUELLE%Herunterfahren.cmd"               "%ZIEL%\" >nul 2>&1
copy /y "%QUELLE%Herunterfahren-30-Sekunden.cmd"   "%ZIEL%\" >nul 2>&1
copy /y "%QUELLE%Abbrechen.cmd"                    "%ZIEL%\" >nul 2>&1
copy /y "%QUELLE%Deinstallieren.cmd"              "%ZIEL%\" >nul 2>&1
copy /y "%QUELLE%Desktop-Verknuepfung-anlegen.cmd" "%ZIEL%\" >nul 2>&1
copy /y "%QUELLE%Icon-aktualisieren.cmd"        "%ZIEL%\" >nul 2>&1
copy /y "%QUELLE%Aufraeumen.cmd"                 "%ZIEL%\" >nul 2>&1
copy /y "%QUELLE%Aufgabe-anlegen.cmd"            "%ZIEL%\" >nul 2>&1
copy /y "%QUELLE%Desktop-aufraeumen.cmd"          "%ZIEL%\" >nul 2>&1
copy /y "%QUELLE%Desktop-Wiederherstellen.cmd"    "%ZIEL%\" >nul 2>&1

goto skripte_fertig

:skripte_ok
echo         Skripte liegen bereits im Zielordner - uebersprungen.

:skripte_fertig
echo   [2/4] Icon aus diesem Skript entpacken ...
set "B64FILE=%TEMP%\hf_icon_%RANDOM%.b64"
> "%B64FILE%" (
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo zpVQplUaV3hTfMbwcyjqvMP3kENTUN4YQ3P8yzBl2Unze/IG9qf7Jt/flW+kRr+YocuFEFprHfTT9OU0TV+RUoZpmp6/cOHCBXgIl0/H3wCi//+Hg1WEAH+zmNT/OP7H8R0dv/IrRvbgb+g+/hs5qRGHGP756U9/+r/XXP7H8T+OdceXvvQlYL0dcvizv3HH/w/Dq8H17tMz9gAAAABJRU5ErkJggg==
)

powershell -NoProfile -ExecutionPolicy Bypass -Command "[IO.File]::WriteAllBytes('%ZIEL%\herunterfahren.ico',[Convert]::FromBase64String((Get-Content -Raw '%B64FILE%')))"
del "%B64FILE%" >nul 2>&1

if not exist "%ZIEL%\herunterfahren.ico" goto fehler_icon

echo   [3/4] Desktop-Verknuepfung mit Icon anlegen ...
set "HF_ZIEL=%ZIEL%"
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
if errorlevel 1 goto fehler_verknuepfung

rem Windows den Icon-Cache neu aufbauen lassen
ie4uinit.exe -show >nul 2>&1

echo   [4/4] Automatisches Aufraeumen mit Administratorrechten einrichten ...
fltmc >nul 2>&1
if not errorlevel 1 goto aufgabe_direkt
echo         (dafuer kommt jetzt einmalig der Windows-UAC-Dialog)
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
goto aufgabe_pruefen

:aufgabe_direkt
call "%ZIEL%\Aufgabe-anlegen.cmd" /quiet

:aufgabe_pruefen
schtasks /query /tn Windows11-Herunterfahren >nul 2>&1
if errorlevel 1 goto aufgabe_fehlt
echo         OK - Aufgabe eingerichtet. Das Aufraeumen laeuft beim
echo         Klick auf "Herunterfahren" automatisch mit Adminrechten.
goto aufgabe_ende

:aufgabe_fehlt
echo         Hinweis: Die Aufgabe wurde nicht eingerichtet.
echo         "Herunterfahren" arbeitet dann ohne die Admin-Ordner
echo         (C:\Windows\Temp und Temp anderer Benutzer).
echo         Nachholen: Rechtsklick auf
echo           %ZIEL%\Aufgabe-anlegen.cmd
echo         -^> "Als Administrator ausfuehren".

:aufgabe_ende


echo.
echo   ==========================================================
echo    FERTIG
echo   ==========================================================
echo.
echo    Auf dem Desktop liegt jetzt die Verknuepfung
echo    "Herunterfahren" mit dem Power-Symbol.
echo    (Falls sie nicht sofort sichtbar ist: Desktop anklicken
echo    und F5 druecken. Fehlt sie ganz: "Desktop-Verknuepfung-
echo    anlegen.cmd" doppelklicken - sie zeigt dann an, welche
echo    Desktop-Ordner Windows meldet.)
echo.
echo    Doppelklick darauf: Windows raeumt AUTOMATISCH alle
echo    Temp-Ordner auf - auch C:\Windows\Temp und die Temp-
echo    Ordner aller Benutzer (laeuft mit Adminrechten, ohne
echo    weitere Nachfrage) - und faehrt danach sauber herunter.
echo    Ohne Rueckfrage und ohne Zwangs-Beenden.
echo.
echo    Tipp: Rechtsklick auf die Verknuepfung -^> "An Taskleiste
echo    anheften" oder "An 'Start' anheften".
echo.
echo    Tipp: Fuer das 30-Sekunden-Fenster gibt es
echo    "Herunterfahren-30-Sekunden.cmd" im Programmordner.
echo.
echo    Deinstallieren: einfach "Deinstallieren.cmd" doppelklicken
echo    - sie liegt im Download-Ordner und wurde auch mit nach
echo    %ZIEL%
echo    kopiert. Sie entfernt Verknuepfung und Programmordner.
echo.
pause
exit /b 0

:fehlt_quelle
echo.
echo   FEHLER: In diesem Ordner fehlt "Herunterfahren.cmd".
echo   Bitte diese Datei zusammen mit den anderen Skripten
echo   in denselben Ordner legen und erneut starten.
echo.
pause
exit /b 1

:fehler_ziel
echo.
echo   FEHLER: Zielordner konnte nicht erstellt werden.
echo   %ZIEL%
echo.
pause
exit /b 1

:fehler_icon
echo.
echo   FEHLER: Das Icon konnte nicht entpackt werden.
echo.
pause
exit /b 1

:fehler_verknuepfung
echo.
echo   FEHLER: Die Desktop-Verknuepfung konnte nicht
echo   erstellt werden. Bitte manuell anlegen (siehe ANLEITUNG.md).
echo.
pause
exit /b 1
