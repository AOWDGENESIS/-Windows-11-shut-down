@echo off
setlocal EnableExtensions
title Windows 11 - automatisches Aufraeumen einrichten
rem ============================================================
rem  Richtet die geplante Aufgabe "Windows11-Herunterfahren" ein.
rem  Sie laesst das Aufraeumen beim Klick auf die Desktop-
rem  Verknuepfung automatisch mit Administratorrechten laufen -
rem  ohne UAC-Abfrage beim taeglichen Benutzen.
rem
rem  Start: Installieren.cmd macht das automatisch mit, oder
rem  diese Datei per Rechtsklick "Als Administrator ausfuehren".
rem  Diese Datei enthaelt absichtlich keine Umlaute.
rem ============================================================

set "QUIET="
if /i "%~1"=="/quiet" set "QUIET=1"

echo.
echo   ==========================================================
echo    Automatisches Aufraeumen einrichten (Administrator)
echo   ==========================================================
echo.

fltmc >nul 2>&1
if errorlevel 1 goto ohne_admin

powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
set "RC=%errorlevel%"

if defined QUIET exit /b %RC%
echo.
pause
exit /b %RC%

:ohne_admin
echo   Diese Datei benoetigt Administratorrechte.
echo.
echo   Bitte per Rechtsklick starten:
echo     "Als Administrator ausfuehren"
echo.
echo   (Normalerweise erledigt "Installieren.cmd" das automatisch.)
echo.
pause
exit /b 1
